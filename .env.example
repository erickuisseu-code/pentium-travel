# Base de données PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/pentium_travel

# Payload CMS — clé secrète (générer une chaîne aléatoire longue)
PAYLOAD_SECRET=change_me_with_a_long_random_string

# Resend (emails) — obtenir sur resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=noreply@pentium-travel.com

# URL publique du site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
